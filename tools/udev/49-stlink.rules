# STMicroelectronics ST-LINK / STLINK-V2 / STLINK-V2-1 / STLINK-V3 udev rules
#
# This file allows non-root users to access ST-LINK programmer/debugger interfaces.
# Copy this file to /etc/udev/rules.d/ and run:
#   sudo udevadm control --reload-rules && sudo udevadm trigger

# STLINK-V1 (e.g. STM32VL Discovery)
SUBSYSTEMS=="usb", ATTRS{idVendor}=="0483", ATTRS{idProduct}=="3744", \
    MODE:="0666", TAG+="uaccess", SYMLINK+="stlinkv1_%n"

# STLINK-V2 (e.g. STM32F4 Discovery, standalone ST-LINK/V2)
SUBSYSTEMS=="usb", ATTRS{idVendor}=="0483", ATTRS{idProduct}=="3748", \
    MODE:="0666", TAG+="uaccess", SYMLINK+="stlinkv2_%n"

# STLINK-V2-1 (e.g. Nucleo boards STM32F0/F4/F7)
SUBSYSTEMS=="usb", ATTRS{idVendor}=="0483", ATTRS{idProduct}=="374a", \
    MODE:="0666", TAG+="uaccess", SYMLINK+="stlinkv2-1_%n"

SUBSYSTEMS=="usb", ATTRS{idVendor}=="0483", ATTRS{idProduct}=="374b", \
    MODE:="0666", TAG+="uaccess", SYMLINK+="stlinkv2-1_%n"

SUBSYSTEMS=="usb", ATTRS{idVendor}=="0483", ATTRS{idProduct}=="3752", \
    MODE:="0666", TAG+="uaccess", SYMLINK+="stlinkv2-1_%n"

# STLINK-V3 (STLINK-V3SET, MINIE, PWR, etc.)
SUBSYSTEMS=="usb", ATTRS{idVendor}=="0483", ATTRS{idProduct}=="374d", \
    MODE:="0666", TAG+="uaccess", SYMLINK+="stlinkv3_%n"

SUBSYSTEMS=="usb", ATTRS{idVendor}=="0483", ATTRS{idProduct}=="374e", \
    MODE:="0666", TAG+="uaccess", SYMLINK+="stlinkv3_%n"

SUBSYSTEMS=="usb", ATTRS{idVendor}=="0483", ATTRS{idProduct}=="374f", \
    MODE:="0666", TAG+="uaccess", SYMLINK+="stlinkv3_%n"

SUBSYSTEMS=="usb", ATTRS{idVendor}=="0483", ATTRS{idProduct}=="3753", \
    MODE:="0666", TAG+="uaccess", SYMLINK+="stlinkv3_%n"

SUBSYSTEMS=="usb", ATTRS{idVendor}=="0483", ATTRS{idProduct}=="3754", \
    MODE:="0666", TAG+="uaccess", SYMLINK+="stlinkv3_%n"

SUBSYSTEMS=="usb", ATTRS{idVendor}=="0483", ATTRS{idProduct}=="3757", \
    MODE:="0666", TAG+="uaccess", SYMLINK+="stlinkv3_%n"
