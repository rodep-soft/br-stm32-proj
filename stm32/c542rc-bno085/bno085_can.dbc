 SG_ Gyro_Z : 128|16@1- (0.001,0) [-32.768|32.767] "rad/s" PC

CM_ BO_ 1280 "BNO085 CAN-FD 18-byte IMU payload (timestamp, sequence, status, 3-axis accelerometer and gyroscope; 20-byte DLC)";
CM_ SG_ 1280 Timestamp_Ms "起動からのミリ秒タイムスタンプ (uint32, ms)";
CM_ SG_ 1280 Seq "フレームのシーケンス番号 (uint8)";
CM_ SG_ 1280 Status "ファームウェアステータス (0=INIT, 1=OK, 2=WARN, 3=ERROR)";
CM_ SG_ 1280 Accel_X "X軸加速度 (int16, 0.001 m/s^2)";
CM_ SG_ 1280 Accel_Y "Y軸加速度 (int16, 0.001 m/s^2)";
CM_ SG_ 1280 Accel_Z "Z軸加速度 (int16, 0.001 m/s^2)";
CM_ SG_ 1280 Gyro_X "X軸角速度 (int16, 0.001 rad/s)";
CM_ SG_ 1280 Gyro_Y "Y軸角速度 (int16, 0.001 rad/s)";
CM_ SG_ 1280 Gyro_Z "Z軸角速度 (int16, 0.001 rad/s)";

